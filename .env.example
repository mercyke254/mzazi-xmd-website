# ─────────────────────────────────────────────────────────────────────────────
# MZAZI XMD WEBSITE — environment
#
# Copy to .env.local and fill in. There is no database URL, bot key or session
# secret here on purpose: this site holds none of them. It is a front end that
# forwards /api/auth/*, /api/pair/* and /api/contact to the platform API, which
# is where the database, the bot key and the session secret already live.
# ─────────────────────────────────────────────────────────────────────────────

# The MZAZI platform API this site talks to. Everything under /api/ is forwarded
# here, server to server. Point it at a staging host to test against staging.
MZAZI_API_BASE=https://www.mzazi.shop

# The public address of THIS site. Used for canonical URLs, the sitemap and
# social previews — it has to be the address people actually visit.
NEXT_PUBLIC_SITE_URL=https://xmd.mzazi.shop

# The main site's address, for the links this one does not re-implement:
# creating an account, plans and prices, the wallet.
NEXT_PUBLIC_MZAZI_SITE=https://www.mzazi.shop
